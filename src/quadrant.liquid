<div class="layout layout--col layout--stretch-x gap--medium">
  <div class="grid grid--cols-2 bp-top bp-quad">
    <div class="flex flex--col flex--left">
      <span class="label label--small">{{ t_today }}</span>
      <span class="value {% if today_len <= 5 %}value--xlarge{% elsif today_len <= 6 %}value--large{% else %}value--base{% endif %} value--tnums bp-nw" data-value-fit="true">{% if has_profile %}{{ today_sats }}{% else %}–{% endif %}</span>
      <span class="label label--small bp-muted">sats</span>
    </div>
    <div class="flex flex--col flex--left">
      {% if payouts_blocked %}
      <span class="label label--small">{{ t_estimated }}</span>
      <span class="value {% if est_len <= 5 %}value--xlarge{% elsif est_len <= 6 %}value--large{% else %}value--base{% endif %} value--tnums bp-nw" data-value-fit="true">~{{ est_sats }}</span>
      <span class="label label--small bp-muted bp-nw">sats · {{ t_payouts_blocked_short }}</span>
      {% else %}
        <span class="label label--small">{{ t_last_payout }}</span>
        <span class="value {% if lp_len <= 5 %}value--xlarge{% elsif lp_len <= 6 %}value--large{% else %}value--base{% endif %} value--tnums bp-nw" data-value-fit="true">{% if last_payout %}{{ lp_sats }}{% else %}–{% endif %}</span>
        <span class="label label--small bp-muted bp-nw">{% if last_payout %}sats · {{ lp_date }}{% if last_payout.status != "confirmed" %} · {{ lp_status }}{% endif %}{% else %}{{ no_payout_short }}{% endif %}</span>
      {% endif %}
    </div>
  </div>
  <div class="flex flex--row flex--between stretch-x">
    <span class="label label--small {% if status_bad %}label--inverted{% else %}label--outline{% endif %}">{{ status_text }}</span>
    <span class="label label--small bp-muted bp-nw">{{ t_hr24_short }}: {% if has_profile %}{{ hr_24h }} {{ hr_label }}{% else %}–{% endif %}</span>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ braiins_logo }}" alt="Braiins">
  <span class="title">Braiins Pool</span>
</div>
