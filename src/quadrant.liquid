<div class="layout layout--col layout--stretch-x gap--medium">
  <div class="grid grid--cols-2 bp-top">
    <div class="flex flex--col flex--left">
      <span class="label label--small">Dnes vytěženo</span>
      <span class="value {% if today_len <= 5 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw">{% if has_profile %}{{ today_sats }}{% else %}–{% endif %}</span>
      <span class="label label--small label--gray">sats</span>
    </div>
    <div class="flex flex--col flex--left">
      <span class="label label--small">Poslední výplata</span>
      <span class="value {% if lp_len <= 5 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw">{% if last_payout %}{{ lp_sats }}{% else %}–{% endif %}</span>
      <span class="label label--small label--gray bp-nw">{% if last_payout %}sats · {{ lp_date }}{% if last_payout.status != "confirmed" %} · {{ lp_status }}{% endif %}{% else %}{{ no_payout_short }}{% endif %}</span>
    </div>
  </div>
  <div class="flex flex--row flex--between stretch-x">
    <span class="label label--small {% if status_bad %}label--inverted{% else %}label--outline{% endif %}">{{ status_text }}</span>
    <span class="label label--small label--gray bp-nw">24 h: {% if has_profile %}{{ hr_24h }} TH/s{% else %}–{% endif %}</span>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ braiins_logo }}" alt="Braiins">
  <span class="title">Braiins Pool</span>
</div>
