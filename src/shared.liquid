{%- comment -%}
  Shared logic – trmnlp and TRMNL prepend this file to every layout template.
  IDX_0 = accounts/profile/json/btc/, IDX_1 = accounts/payouts/json/btc, IDX_2 = accounts/rewards/json/btc
{%- endcomment -%}

{%- comment -%}
  Language: custom field `language` (Auto / English / Čeština); Auto = Czech for locale cs, English otherwise.
{%- endcomment -%}
{%- assign lang_pref = trmnl.plugin_settings.custom_fields_values.language | default: "Auto" -%}
{%- assign user_locale = trmnl.user.locale | default: "en" | downcase | slice: 0, 2 -%}
{%- if lang_pref == "Čeština" -%}{%- assign lang = "cs" -%}
{%- elsif lang_pref == "English" -%}{%- assign lang = "en" -%}
{%- elsif user_locale == "cs" -%}{%- assign lang = "cs" -%}
{%- else -%}{%- assign lang = "en" -%}
{%- endif -%}
{%- if lang == "cs" -%}
  {%- assign sep_t = " " -%}{%- assign sep_d = "," -%}
  {%- assign fmt_date = "%-d. %-m. %Y" -%}{%- assign fmt_date_short = "%-d. %-m." -%}
  {%- assign t_today = "Dnes vytěženo" -%}
  {%- assign t_last_payout = "Poslední výplata" -%}
  {%- assign t_hr24 = "Hashrate 24 h" -%}
  {%- assign t_hr24_short = "24 h" -%}
  {%- assign t_total = "Celkem vytěženo" -%}
  {%- assign t_total_short = "Celkem" -%}
  {%- assign t_daily = "Denní odměny" -%}
  {%- assign t_per_day = "sats/den" -%}
  {%- assign t_payout_mark = "výplata" -%}
  {%- assign t_no_data = "Bez dat" -%}
  {%- assign t_no_payout = "Žádná za posledních 90 dní" -%}
  {%- assign t_no_payout_short = "Žádná za 90 dní" -%}
  {%- assign t_api_down = "API nedostupné" -%}
  {%- assign t_online = "Online" -%}
  {%- assign t_offline = "Offline" -%}
  {%- assign t_low = "Nízký výkon" -%}
  {%- assign t_low_short = "slabý" -%}
  {%- assign t_no_workers = "Žádný worker" -%}
  {%- assign t_confirmed = "Potvrzena" -%}
  {%- assign t_queued = "Ve frontě" -%}
  {%- assign t_failed = "Selhala" -%}
  {%- assign t_estimated = "Odhad na dnes" -%}
  {%- assign t_payouts_blocked = "Výplaty nejsou pro tento token dostupné" -%}
  {%- assign t_payouts_blocked_short = "Bez přístupu k výplatám" -%}
{%- else -%}
  {%- assign sep_t = "," -%}{%- assign sep_d = "." -%}
  {%- assign fmt_date = "%b %-d, %Y" -%}{%- assign fmt_date_short = "%b %-d" -%}
  {%- assign t_today = "Mined today" -%}
  {%- assign t_last_payout = "Last payout" -%}
  {%- assign t_hr24 = "Hashrate 24h" -%}
  {%- assign t_hr24_short = "24h" -%}
  {%- assign t_total = "Total mined" -%}
  {%- assign t_total_short = "Total" -%}
  {%- assign t_daily = "Daily rewards" -%}
  {%- assign t_per_day = "sats/day" -%}
  {%- assign t_payout_mark = "payout" -%}
  {%- assign t_no_data = "No data" -%}
  {%- assign t_no_payout = "None in the last 90 days" -%}
  {%- assign t_no_payout_short = "None in 90 days" -%}
  {%- assign t_api_down = "API unavailable" -%}
  {%- assign t_online = "Online" -%}
  {%- assign t_offline = "Offline" -%}
  {%- assign t_low = "Low hashrate" -%}
  {%- assign t_low_short = "low" -%}
  {%- assign t_no_workers = "No workers" -%}
  {%- assign t_confirmed = "Confirmed" -%}
  {%- assign t_queued = "Queued" -%}
  {%- assign t_failed = "Failed" -%}
  {%- assign t_estimated = "Estimated today" -%}
  {%- assign t_payouts_blocked = "Payouts not available for this token" -%}
  {%- assign t_payouts_blocked_short = "No payout access" -%}
{%- endif -%}

{%- comment -%}
  Data sources. With the token set to "demo" the plugin renders built-in sample data instead of the API
  (used by the published recipe master, which must not show anyone's real account). Dates are relative
  to the current time so the demo always looks current.
{%- endcomment -%}
{%- assign token_value = trmnl.plugin_settings.custom_fields_values.pool_token | default: "" | strip | downcase -%}
{%- assign demo_mode = false -%}
{%- if token_value == "demo" -%}{%- assign demo_mode = true -%}{%- endif -%}
{%- if demo_mode -%}
  {%- assign now_ts = trmnl.system.timestamp_utc | default: 0 | plus: 0 -%}
  {%- if now_ts == 0 -%}{%- assign now_ts = "now" | date: "%s" | plus: 0 -%}{%- endif -%}
  {%- assign sec_of_day = now_ts | modulo: 86400 -%}
  {%- assign day0 = now_ts | minus: sec_of_day -%}
  {%- assign today_demo = sec_of_day | times: 160 | divided_by: 86400 -%}
  {%- assign demo_daily = "158,161,157,163,160,98,155,159,162,158,160,157,161,159" | split: "," -%}
  {%- capture demo_profile_json -%}
    {"btc":{"hash_rate_unit":"Gh/s","hash_rate_5m":3480.2,"hash_rate_60m":3461.9,"hash_rate_24h":3452.7,
    "ok_workers":3,"low_workers":0,"off_workers":0,"dis_workers":0,
    "current_balance":"0.00000312","today_reward":{{ today_demo | divided_by: 100000000.0 }},
    "estimated_reward":"0.00000160","all_time_reward":"0.00123456"}}
  {%- endcapture -%}
  {%- capture demo_payouts_json -%}
    {"onchain":[],"lightning":[
    {%- for k in (0..9) -%}
      {%- assign ts = k | times: 3 | plus: 1 | times: 86400 | minus: 32400 -%}
      {%- assign ts = day0 | minus: ts -%}
      {"requested_at_ts":{{ ts }},"resolved_at_ts":{{ ts | plus: 400 }},"status":"confirmed","amount_sats":{{ 480 | plus: k }},"fee_sats":0}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]}
  {%- endcapture -%}
  {%- capture demo_rewards_json -%}
    {"btc":{"daily_rewards":[
    {%- for i in (1..14) -%}
      {%- assign idx = i | minus: 1 -%}
      {"date":{{ i | times: 86400 | minus: day0 | times: -1 }},"total_reward":{{ demo_daily[idx] | plus: 0 | divided_by: 100000000.0 }}}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}]}}
  {%- endcapture -%}
  {%- assign src_profile = demo_profile_json | parse_json -%}
  {%- assign src_payouts = demo_payouts_json | parse_json -%}
  {%- assign src_rewards = demo_rewards_json | parse_json -%}
{%- else -%}
  {%- assign src_profile = IDX_0 -%}
  {%- assign src_payouts = IDX_1 -%}
  {%- assign src_rewards = IDX_2 -%}
{%- endif -%}

{%- assign p = src_profile.btc -%}
{%- assign has_profile = false -%}
{%- if p and p.hash_rate_5m != nil -%}{%- assign has_profile = true -%}{%- endif -%}

{%- comment -%} 24h hashrate → TH/s based on hash_rate_unit (usually Gh/s); shown in PH/s from 1000 TH/s {%- endcomment -%}
{%- assign hr_unit = p.hash_rate_unit | downcase -%}
{%- case hr_unit -%}
  {%- when "ph/s" -%}{%- assign hr_factor = 1000 -%}
  {%- when "th/s" -%}{%- assign hr_factor = 1 -%}
  {%- when "mh/s" -%}{%- assign hr_factor = 0.000001 -%}
  {%- else -%}{%- assign hr_factor = 0.001 -%}
{%- endcase -%}
{%- assign hr_24h_th = p.hash_rate_24h | default: 0 | times: hr_factor -%}
{%- if hr_24h_th >= 1000 -%}
  {%- assign hr_24h = hr_24h_th | divided_by: 1000.0 | number_to_currency: "", sep_t, sep_d, 2 -%}{%- assign hr_label = "PH/s" -%}
{%- else -%}
  {%- assign hr_24h = hr_24h_th | number_to_currency: "", sep_t, sep_d, 2 -%}{%- assign hr_label = "TH/s" -%}
{%- endif -%}

{%- comment -%} BTC strings → sats {%- endcomment -%}
{%- assign total_sats = p.all_time_reward | default: 0 | times: 100000000 | round | number_with_delimiter: sep_t, sep_d -%}
{%- assign est_sats = p.estimated_reward | default: 0 | times: 100000000 | round | number_with_delimiter: sep_t, sep_d -%}
{%- assign est_len = est_sats | size -%}
{%- assign today_sats = p.today_reward | default: 0 | times: 100000000 | round | number_with_delimiter: sep_t, sep_d -%}
{%- comment -%} Font size by number length (characters incl. separators) so it fits its column {%- endcomment -%}
{%- assign today_len = today_sats | size -%}

{%- comment -%}
  Worker status. Single worker → words (Online / Offline / Low hashrate),
  multiple workers → counts with context, e.g. "3/12 offline · 1 low".
{%- endcomment -%}
{%- assign w_ok = p.ok_workers | default: 0 -%}
{%- assign w_low = p.low_workers | default: 0 -%}
{%- assign w_off = p.off_workers | default: 0 -%}
{%- assign w_alive = w_ok | plus: w_low -%}
{%- assign w_total = w_alive | plus: w_off -%}
{%- assign status_bad = true -%}
{%- if has_profile == false -%}
  {%- assign status_text = t_api_down -%}
{%- elsif w_total == 0 -%}
  {%- assign status_text = t_no_workers -%}
{%- elsif w_alive == 0 -%}
  {%- assign status_text = t_offline -%}
{%- elsif w_off == 0 and w_low == 0 -%}
  {%- assign status_text = t_online -%}{%- assign status_bad = false -%}
{%- elsif w_total == 1 -%}
  {%- assign status_text = t_low -%}
{%- else -%}
  {%- capture status_text -%}
    {%- if w_off > 0 -%}{{ w_off }}/{{ w_total }} offline{%- endif -%}
    {%- if w_off > 0 and w_low > 0 %} · {% endif -%}
    {%- if w_low > 0 -%}{% if w_off == 0 %}{{ w_low }}/{{ w_total }} {{ t_low_short }}{% else %}{{ w_low }} {{ t_low_short }}{% endif %}{%- endif -%}
  {%- endcapture -%}
{%- endif -%}

{%- comment -%}
  Last payout: lightning + onchain, sorted by requested_at_ts (int), take the last one.
  The API returns items in ascending order (oldest first), so `last` is correct even without sort.
{%- endcomment -%}
{%- assign empty_list = "" | split: "," -%}
{%- comment -%}
  A "Limited read-only" access profile gets HTTP 401 "Payout history access is not allowed."
  from the payouts endpoint while everything else works. If the profile arrived but payouts did not,
  treat payouts as blocked and show the estimated reward for today instead.
{%- endcomment -%}
{%- assign payouts_blocked = false -%}
{%- if has_profile and src_payouts.lightning == nil and src_payouts.onchain == nil -%}{%- assign payouts_blocked = true -%}{%- endif -%}
{%- if src_payouts.lightning == nil and src_payouts.onchain == nil -%}
  {%- assign no_payout_text = t_no_data -%}{%- assign no_payout_short = t_no_data -%}
{%- else -%}
  {%- assign no_payout_text = t_no_payout -%}{%- assign no_payout_short = t_no_payout_short -%}
{%- endif -%}
{%- assign pay_ln = src_payouts.lightning | default: empty_list -%}
{%- assign pay_oc = src_payouts.onchain | default: empty_list -%}
{%- assign payouts = pay_ln | concat: pay_oc | sort: "requested_at_ts" -%}
{%- assign last_payout = payouts | last -%}
{%- if last_payout -%}
  {%- assign lp_sats = last_payout.amount_sats | default: 0 | number_with_delimiter: sep_t, sep_d -%}
  {%- assign lp_len = lp_sats | size -%}
  {%- assign lp_date = last_payout.requested_at_ts | plus: trmnl.user.utc_offset | date: fmt_date -%}
  {%- case last_payout.status -%}
    {%- when "confirmed" -%}{%- assign lp_status = t_confirmed -%}
    {%- when "queued" -%}{%- assign lp_status = t_queued -%}
    {%- when "failed" -%}{%- assign lp_status = t_failed -%}
    {%- else -%}{%- assign lp_status = last_payout.status | default: "?" -%}
  {%- endcase -%}
{%- endif -%}

{%- comment -%}
  Daily rewards (IDX_2): completed days only, the API returns newest first → sort ascending.
  Bar height in 5 % steps (classes bp-h-0…bp-h-100), axis always starts at zero.
  Dot under a bar = a payout was requested that day (UTC, same as the reward `date`).
{%- endcomment -%}
{%- assign rewards = src_rewards.btc.daily_rewards | default: empty_list | sort: "date" -%}
{%- assign rw_max = 1 -%}{%- assign rw_sum = 0 -%}
{%- for d in rewards -%}
  {%- assign v = d.total_reward | times: 100000000 | round -%}
  {%- assign rw_sum = rw_sum | plus: v -%}
  {%- if v > rw_max -%}{%- assign rw_max = v -%}{%- endif -%}
{%- endfor -%}
{%- if rewards.size > 0 -%}
  {%- assign rw_avg = rw_sum | divided_by: rewards.size | number_with_delimiter: sep_t, sep_d -%}
{%- endif -%}

{%- assign chart_offset = 0 -%}{%- if rewards.size > 14 -%}{%- assign chart_offset = rewards.size | minus: 14 -%}{%- endif -%}
{%- capture reward_chart_14 -%}
<div class="bp-chartbox">
<div class="bp-chart">
  {%- for d in rewards offset: chart_offset -%}
    {%- assign v = d.total_reward | times: 100000000 | round -%}
    {%- assign h = v | times: 20 | divided_by: rw_max | times: 5 -%}
    {%- if v > 0 and h < 5 -%}{%- assign h = 5 -%}{%- endif -%}
    {%- assign day_end = d.date | plus: 86400 -%}
    {%- assign paid = false -%}
    {%- for x in payouts -%}{%- if x.requested_at_ts >= d.date and x.requested_at_ts < day_end -%}{%- assign paid = true -%}{%- endif -%}{%- endfor -%}
    <div class="bp-col">
      <div class="bp-colarea flex flex--row flex--center-x flex--bottom"><div class="bp-colbar bp-h-{{ h }}"></div></div>
      <div class="bp-mark flex flex--row flex--center-x flex--center">{% if paid %}<span class="bp-dot rounded--full"></span>{% endif %}</div>
    </div>
  {%- endfor -%}
</div>
{%- assign first_day = rewards[chart_offset] -%}{%- assign last_day = rewards | last -%}
<div class="flex flex--row flex--between stretch-x">
  <span class="label label--small bp-muted">{{ first_day.date | plus: trmnl.user.utc_offset | date: fmt_date_short }}</span>
  <span class="label label--small bp-muted">{% unless payouts_blocked %}• {{ t_payout_mark }}{% endunless %}</span>
  <span class="label label--small bp-muted">{{ last_day.date | plus: trmnl.user.utc_offset | date: fmt_date_short }}</span>
</div>
</div>
{%- endcapture -%}
{%- assign chart_offset = 0 -%}{%- if rewards.size > 7 -%}{%- assign chart_offset = rewards.size | minus: 7 -%}{%- endif -%}
{%- capture reward_chart_7 -%}
<div class="bp-chartbox">
<div class="bp-chart">
  {%- for d in rewards offset: chart_offset -%}
    {%- assign v = d.total_reward | times: 100000000 | round -%}
    {%- assign h = v | times: 20 | divided_by: rw_max | times: 5 -%}
    {%- if v > 0 and h < 5 -%}{%- assign h = 5 -%}{%- endif -%}
    {%- assign day_end = d.date | plus: 86400 -%}
    {%- assign paid = false -%}
    {%- for x in payouts -%}{%- if x.requested_at_ts >= d.date and x.requested_at_ts < day_end -%}{%- assign paid = true -%}{%- endif -%}{%- endfor -%}
    <div class="bp-col">
      <div class="bp-colarea flex flex--row flex--center-x flex--bottom"><div class="bp-colbar bp-h-{{ h }}"></div></div>
      <div class="bp-mark flex flex--row flex--center-x flex--center">{% if paid %}<span class="bp-dot rounded--full"></span>{% endif %}</div>
    </div>
  {%- endfor -%}
</div>
{%- assign first_day = rewards[chart_offset] -%}{%- assign last_day = rewards | last -%}
<div class="flex flex--row flex--between stretch-x">
  <span class="label label--small bp-muted">{{ first_day.date | plus: trmnl.user.utc_offset | date: fmt_date_short }}</span>
  <span class="label label--small bp-muted">{% unless payouts_blocked %}• {{ t_payout_mark }}{% endunless %}</span>
  <span class="label label--small bp-muted">{{ last_day.date | plus: trmnl.user.utc_offset | date: fmt_date_short }}</span>
</div>
</div>
{%- endcapture -%}
{%- comment -%} Braiins symbol (design.braiins.com/braiins/logos/braiins-symbol), black variant {%- endcomment -%}
{%- capture braiins_logo -%}data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 864 864'%3E%3Cpolygon points='345.6 864 345.6 682.76 194.4 179.9 194.4 0 0 0 0 179.9 151.2 682.76 151.2 864 345.6 864'/%3E%3Cpolygon points='864 864 864 682.76 712.8 179.9 712.8 0 518.4 0 518.4 179.9 669.6 682.76 669.6 864 864 864'/%3E%3C/svg%3E{%- endcapture -%}
{%- assign instance = trmnl.plugin_settings.instance_name | default: "Braiins Pool" -%}
{%- comment -%} Numbers must not wrap (the thousands separator may be a space) {%- endcomment -%}
<style>
  .bp-nw { white-space: nowrap; }
  /* Secondary labels: gray on 2/4-bit, black on 1-bit (dithered gray is unreadable at small sizes) */
  .bp-muted { color: #666; }
  .screen--1bit .bp-muted { color: #000; }
  .bp-pair { display: flex; flex-direction: column; align-items: flex-end; }
  /* Portrait: main numbers side by side, hashrate/total/status as a row below; quadrant stacked */
  .screen--portrait .bp-main { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 16px; column-gap: 24px; }
  .screen--portrait .bp-main > .col--span-2 { grid-column: span 1; }
  .screen--portrait .bp-side { grid-column: 1 / -1; flex-direction: row; justify-content: space-between; align-items: flex-end; }
  .screen--portrait .bp-side .bp-pair { align-items: flex-start; }
  .screen--portrait .bp-quad { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
  /* Small screens (OG 800×480): the chart does not fit in half_vertical */
  .screen--md .bp-hide-md { display: none; }
  .bp-top { align-items: start; }
  .bp-top > * { min-width: 0; }
  /* data-value-fit container: may shrink to the space left next to the "sats" unit */
  .bp-fitrow { width: 100%; }
  .bp-fitbox { flex: 0 1 auto; min-width: 0; }
  .bp-grow { flex: 0 0 auto; height: 42%; min-height: 0; display: flex; flex-direction: column; }
  .bp-grow--tall { height: 36%; }
  .bp-chartbox { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; gap: 4px; }
  .bp-chart { flex: 1 1 auto; min-height: 60px; display: flex; align-items: stretch; gap: 0; }
  .bp-col { flex: 1 1 0; display: flex; flex-direction: column; }
  .bp-colarea { flex: 1 1 auto; border-bottom: 2px solid #000; }
  .bp-colbar { width: 38%; background: #000; border-radius: 4px 4px 0 0; }
  .bp-mark { height: 14px; }
  .bp-dot { width: 8px; height: 8px; background: #000; }
  .bp-h-0 { height: 0%; }
  .bp-h-5 { height: 5%; }
  .bp-h-10 { height: 10%; }
  .bp-h-15 { height: 15%; }
  .bp-h-20 { height: 20%; }
  .bp-h-25 { height: 25%; }
  .bp-h-30 { height: 30%; }
  .bp-h-35 { height: 35%; }
  .bp-h-40 { height: 40%; }
  .bp-h-45 { height: 45%; }
  .bp-h-50 { height: 50%; }
  .bp-h-55 { height: 55%; }
  .bp-h-60 { height: 60%; }
  .bp-h-65 { height: 65%; }
  .bp-h-70 { height: 70%; }
  .bp-h-75 { height: 75%; }
  .bp-h-80 { height: 80%; }
  .bp-h-85 { height: 85%; }
  .bp-h-90 { height: 90%; }
  .bp-h-95 { height: 95%; }
  .bp-h-100 { height: 100%; }
</style>
