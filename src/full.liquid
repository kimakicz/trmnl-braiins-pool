<div class="layout layout--col layout--stretch-x gap--space-between">
  <div class="grid grid--cols-5 bp-top bp-main">
    <div class="col--span-2 flex flex--col flex--left">
      <span class="label">{{ t_today }}</span>
      <div class="flex flex--row flex--bottom gap--small flex--left bp-fitrow">
        {% if has_profile %}
          <div class="bp-fitbox"><span class="value {% if today_len <= 3 %}value--xxxlarge{% elsif today_len <= 5 %}value--xxlarge{% elsif today_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw" data-value-fit="true">{{ today_sats }}</span></div>
          <span class="value value--base">sats</span>
        {% else %}
          <span class="value value--xlarge">{{ t_no_data }}</span>
        {% endif %}
      </div>
    </div>
    <div class="col--span-2 flex flex--col flex--left">
      {% if payouts_blocked %}
      <span class="label">{{ t_estimated }}</span>
      <div class="flex flex--row flex--bottom gap--small flex--left bp-fitrow">
        <div class="bp-fitbox"><span class="value {% if est_len <= 3 %}value--xxxlarge{% elsif est_len <= 5 %}value--xxlarge{% elsif est_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw" data-value-fit="true">~{{ est_sats }}</span></div>
        <span class="value value--base">sats</span>
      </div>
      <span class="label bp-muted">{{ t_payouts_blocked }}</span>
      {% else %}
        <span class="label">{{ t_last_payout }}</span>
        {% if last_payout %}
          <div class="flex flex--row flex--bottom gap--small flex--left bp-fitrow">
            <div class="bp-fitbox"><span class="value {% if lp_len <= 3 %}value--xxxlarge{% elsif lp_len <= 5 %}value--xxlarge{% elsif lp_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw" data-value-fit="true">{{ lp_sats }}</span></div>
            <span class="value value--base">sats</span>
          </div>
          <span class="label bp-muted">{{ lp_date }} · {{ lp_status }}</span>
        {% else %}
          <span class="value value--xlarge">–</span>
          <span class="label bp-muted">{{ no_payout_text }}</span>
        {% endif %}
      {% endif %}
    </div>
    <div class="flex flex--col flex--right gap--medium bp-side">
      <span class="label {% if status_bad %}label--inverted{% else %}label--outline{% endif %}">{{ status_text }}</span>
      <div class="bp-pair">
        <span class="value value--small value--tnums bp-nw">{% if has_profile %}{{ hr_24h }} {{ hr_label }}{% else %}–{% endif %}</span>
        <span class="label label--small bp-muted">{{ t_hr24 }}</span>
      </div>
      {% if has_profile %}
        <div class="bp-pair">
          <span class="value value--small value--tnums bp-nw">{{ total_sats }} sats</span>
          <span class="label label--small bp-muted">{{ t_total }}</span>
        </div>
      {% endif %}
    </div>
  </div>

  {% if rewards.size > 0 %}
  <div class="bp-grow gap--small">
    <div class="flex flex--row flex--between stretch-x">
      <span class="label">{{ t_daily }}</span>
      <span class="label bp-muted bp-nw">Ø {{ rw_avg }} {{ t_per_day }}</span>
    </div>
    {{ reward_chart_14 }}
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <img class="image" src="{{ braiins_logo }}" alt="Braiins">
  <span class="title">Braiins Pool</span>
  <span class="instance">{{ instance }}</span>
</div>
