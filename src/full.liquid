<div class="layout layout--col layout--stretch-x gap--xlarge">
  <div class="grid grid--cols-3">
    <div class="col--span-2 flex flex--col flex--left">
      <span class="label">Hashrate · 5 min</span>
      <div class="flex flex--row flex--bottom gap--small">
        {% if has_profile %}<span class="value value--giga value--tnums">{{ hr_5m }}</span>{% else %}<span class="value value--xlarge">Bez dat</span>{% endif %}
        {% if has_profile %}<span class="value value--large">TH/s</span>{% endif %}
      </div>
    </div>
    <div class="flex flex--col flex--right flex--bottom gap--small">
      <span class="label {% if status_bad %}label--inverted{% else %}label--outline{% endif %} label--large">{{ status_text }}</span>
      <span class="value value--large value--tnums">{% if has_profile %}{{ hr_24h }} TH/s{% else %}–{% endif %}</span>
      <span class="label label--gray">Průměr 24 h</span>
    </div>
  </div>

  <div class="divider"></div>

  <div class="grid grid--cols-3">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">K výplatě</span>
        <span class="value {% if bal_len <= 5 %}value--xxlarge{% elsif bal_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw">{% if has_profile %}{{ balance_sats }}{% else %}–{% endif %}</span>
        <span class="label label--gray">sats</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Dnes vytěženo</span>
        <span class="value {% if today_len <= 5 %}value--xxlarge{% elsif today_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw">{% if has_profile %}{{ today_sats }}{% else %}–{% endif %}</span>
        <span class="label label--gray">sats</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="label">Poslední výplata</span>
        {% if last_payout %}
          <span class="value {% if lp_len <= 5 %}value--xxlarge{% elsif lp_len <= 7 %}value--xlarge{% else %}value--large{% endif %} value--tnums bp-nw">{{ lp_sats }}</span>
          <span class="label label--gray">sats · {{ lp_date }} · {{ lp_status }}</span>
        {% else %}
          <span class="value value--xxlarge">–</span>
          <span class="label label--gray">{{ no_payout_text }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <span class="title">Braiins Pool</span>
  <span class="instance">{{ instance }}</span>
</div>
