#!/usr/bin/env bash
# Feeds the running `trmnlp serve` with scenario data (fixtures/scenarios/<name>.json).
# trmnlp reads polled data from ~/.cache/trmnl/data.json on every render.
# Back to live data: bin/scenario --live (triggers /poll).
set -euo pipefail
cd "$(dirname "$0")/.."
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/trmnl/data.json"
if [ "${1:-}" = "--live" ]; then curl -s -o /dev/null http://127.0.0.1:4567/poll; echo "live"; exit; fi
cp "fixtures/scenarios/${1:?scenario name}.json" "$CACHE"; echo "$1"
