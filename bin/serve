#!/usr/bin/env bash
# Starts the trmnlp preview with the token from .env.
# TZ=UTC: Liquid `date` on a unix timestamp uses the process time zone; TRMNL servers run in UTC
# and the template shifts to local time via trmnl.user.utc_offset.
set -euo pipefail
cd "$(dirname "$0")/.."
# Homebrew Ruby is keg-only – trmnlp needs Ruby >= 4.0, the macOS system Ruby is 2.6
if [ -x /opt/homebrew/opt/ruby/bin/ruby ]; then
  export PATH="/opt/homebrew/opt/ruby/bin:$(/opt/homebrew/opt/ruby/bin/gem env gemdir)/bin:$PATH"
fi
set -a; [ -f .env ] && source .env; set +a
export TZ=UTC
exec trmnlp serve "$@"
